{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'No frontend dependencies'",
  "buildCommand": "node scripts/build-site.mjs",
  "outputDirectory": "site",
  "rewrites": [
    {"source": "/api/:path*", "destination": "https://resume-api.lordpatil.com/handwriting/api/:path*"},
    {"source": "/health", "destination": "https://resume-api.lordpatil.com/handwriting/health"},
    {"source": "/docs", "destination": "https://resume-api.lordpatil.com/handwriting/docs"},
    {"source": "/docs/:path*", "destination": "https://resume-api.lordpatil.com/handwriting/docs/:path*"},
    {"source": "/openapi.json", "destination": "https://resume-api.lordpatil.com/handwriting/openapi.json"}
  ],
  "headers": [
    {"source": "/api/:path*", "headers": [{"key": "Cache-Control", "value": "no-store"}]},
    {"source": "/:path*", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "no-referrer"}]}
  ]
}
